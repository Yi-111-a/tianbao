{"id": "7b6ef9bd43324663bf54eaa8da466bbf", "initial_state": {"armies": {"anxi_army": {"commander": "gao_xianzhi", "faction": "tang", "id": "anxi_army", "in_transit": null, "loyal_to": null, "name": "安西四镇兵", "quality": 1.1, "region": "anxi", "strength": 24000.0}, "beiting_army": {"commander": null, "faction": "tang", "id": "beiting_army", "in_transit": null, "loyal_to": null, "name": "北庭军", "quality": 1.0, "region": "beiting", "strength": 20000.0}, "dongdu_army": {"commander": null, "faction": "tang", "id": "dongdu_army", "in_transit": null, "loyal_to": "xuanzong", "name": "东都留守兵", "quality": 0.6, "region": "duji", "strength": 10000.0}, "fanyang_army": {"commander": "an_lushan", "faction": "tang", "id": "fanyang_army", "in_transit": null, "loyal_to": "an_lushan", "name": "范阳军", "quality": 1.15, "region": "fanyang", "strength": 91400.0}, "hedong_army": {"commander": null, "faction": "tang", "id": "hedong_army", "in_transit": null, "loyal_to": null, "name": "河东军", "quality": 1.0, "region": "hedong", "strength": 55000.0}, "hexi_army": {"commander": "an_sishun", "faction": "tang", "id": "hexi_army", "in_transit": null, "loyal_to": null, "name": "河西军", "quality": 1.0, "region": "hexi", "strength": 73000.0}, "jiannan_army": {"commander": "xianyu_zhongtong", "faction": "tang", "id": "jiannan_army", "in_transit": null, "loyal_to": null, "name": "剑南军", "quality": 0.85, "region": "jiannan", "strength": 30900.0}, "jinjun": {"commander": null, "faction": "tang", "id": "jinjun", "in_transit": null, "loyal_to": "xuanzong", "name": "京师禁军", "quality": 0.6, "region": "jingji", "strength": 40000.0}, "khitan_army": {"commander": null, "faction": "khitan_xi", "id": "khitan_army", "in_transit": null, "loyal_to": null, "name": "契丹·奚兵", "quality": 0.95, "region": "khitan_xi", "strength": 50000.0}, "lingnan_army": {"commander": null, "faction": "tang", "id": "lingnan_army", "in_transit": null, "loyal_to": null, "name": "岭南五府兵", "quality": 0.7, "region": "lingnan", "strength": 15400.0}, "longyou_army": {"commander": "geshu_han", "faction": "tang", "id": "longyou_army", "in_transit": null, "loyal_to": "geshu_han", "name": "陇右军", "quality": 1.05, "region": "longyou", "strength": 75000.0}, "nanzhao_army": {"commander": null, "faction": "nanzhao", "id": "nanzhao_army", "in_transit": null, "loyal_to": null, "name": "南诏军", "quality": 0.9, "region": "nanzhao", "strength": 40000.0}, "pinglu_army": {"commander": "an_lushan", "faction": "tang", "id": "pinglu_army", "in_transit": null, "loyal_to": "an_lushan", "name": "平卢军", "quality": 1.1, "region": "pinglu", "strength": 37500.0}, "shuofang_army": {"commander": null, "faction": "tang", "id": "shuofang_army", "in_transit": null, "loyal_to": null, "name": "朔方军", "quality": 1.05, "region": "shuofang", "strength": 64700.0}, "tubo_army": {"commander": null, "faction": "tubo", "id": "tubo_army", "in_transit": null, "loyal_to": null, "name": "吐蕃军", "quality": 1.0, "region": "tubo", "strength": 80000.0}}, "calendar": {"label": "天宝十载春", "month": 1, "season": "春", "year": 751}, "characters": {"an_lushan": {"bloc": "fanyang", "faction": "tang", "id": "an_lushan", "in_transit": null, "knowledge": ["范阳兵马", "契丹、奚事", "朝中谁欲害己"], "memories": [], "name": "安禄山", "office": "fanyang_jds", "offices": ["pinglu_jds", "fanyang_jds"], "persona": "营州杂胡出身，平卢、范阳节度使，天宝九载封东平郡王。体态肥硕，以胡人憨直自处，深得陛下与贵妃宠信。自九载冬入朝，今正月仍在长安。麾下有同罗、奚、契丹降者组成的曳落河精骑。畏惧宰相与东宫，与杨国忠交恶。其野心由隐藏数值「禄山异志」决定。", "region": "jingji", "speech_style": "自称「臣胡人」，言辞憨直诙谐，常插科打诨；一问到兵权便转而表忠心，说「臣只知有陛下」。例：「臣胡人，不识汉家礼数，只知有陛下，不知有别人。」", "status": "alive", "title": "东平郡王", "traits": {"ability": 8.0, "favor": 9.0, "fear": 4.0, "loyalty": 4.0}}, "an_sishun": {"bloc": "xibei", "faction": "tang", "id": "an_sishun", "in_transit": null, "knowledge": ["河西兵马", "河西诸胡部落"], "memories": [], "name": "安思顺", "office": "hexi_jds", "offices": ["hexi_jds"], "persona": "粟特裔边帅，河西节度使，深得河西诸胡拥戴。安禄山冒姓安氏，与之约为兄弟，二人并无血亲。", "region": "hexi", "speech_style": "稳重谨慎，称「臣」；谈到安禄山便格外小心措辞。例：「禄山与臣，不过约为兄弟，臣只知有国家。」", "status": "alive", "title": "河西节度使", "traits": {"ability": 6.0, "ambition": 3.0, "favor": 6.0, "fear": 5.0, "loyalty": 7.0}}, "bian_lingcheng": {"bloc": "neiting", "faction": "tang", "id": "bian_lingcheng", "in_transit": null, "knowledge": ["监军所闻", "诸将私语"], "memories": [], "name": "边令诚", "office": null, "offices": [], "persona": "内侍，曾出任安西监军。谨小慎微，借皇命狐假虎威，与诸将多有嫌隙。", "region": "jingji", "speech_style": "对上卑恭，自称「奴婢」；对将帅则口称「奉敕」。例：「奴婢奉敕监军，诸将一言一行，奴婢都替大家记着。」", "status": "alive", "title": "宦官·监军", "traits": {"ability": 4.0, "ambition": 5.0, "favor": 5.0, "fear": 6.0, "loyalty": 6.0}}, "chen_xilie": {"bloc": "xiang", "faction": "tang", "id": "chen_xilie", "in_transit": null, "knowledge": ["道家经义", "政事堂旧例"], "memories": [], "name": "陈希烈", "office": "zuo_xiang", "offices": ["zuo_xiang"], "persona": "左相，以讲论道家经义得进。凡事附和右相，在政事堂中不甚任事。", "region": "jingji", "speech_style": "唯唯诺诺，多说「右相所言甚是」「臣无异议」，偶引《老子》清静之言。例：「右相所言甚是，臣无异议。」", "status": "alive", "title": "左相", "traits": {"ability": 4.0, "ambition": 3.0, "favor": 5.0, "fear": 6.0, "loyalty": 5.0}}, "feng_changqing": {"bloc": "xibei", "faction": "tang", "id": "feng_changqing", "in_transit": null, "knowledge": ["安西兵马与粮储", "西域道路"], "memories": [], "name": "封常清", "office": null, "offices": [], "persona": "身材细瘦，一足偏短，貌不惊人而有干才。久为高仙芝判官，常知留后事，文书奏报出其手。", "region": "anxi", "speech_style": "文辞犀利，务实，先说数目与粮道，再说结论；称「臣」。例：「兵不在多，在粮道与号令。东都若要守，须先修城、募兵、储粮。」", "status": "alive", "title": "安西节度判官", "traits": {"ability": 8.0, "ambition": 3.0, "favor": 3.0, "fear": 3.0, "loyalty": 9.0}}, "gao_lishi": {"bloc": "neiting", "faction": "tang", "id": "gao_lishi", "in_transit": null, "knowledge": ["内廷耳目", "各方真实风声", "宫中旧事"], "memories": [], "name": "高力士", "office": null, "offices": [], "persona": "内廷第一人，侍奉陛下数十年，四方章奏多先经其手。谨守本分，处事圆融；只在独对时直言，人前从不与宰相争。", "region": "jingji", "speech_style": "自称「老奴」，话少，点到为止；人前只说「圣意所在」，独对时才说「老奴斗胆」。例：「圣意所在，老奴不敢多言。」", "status": "alive", "title": "骠骑大将军、知内侍省事", "traits": {"ability": 7.0, "ambition": 3.0, "favor": 9.0, "fear": 3.0, "loyalty": 10.0}}, "gao_xianzhi": {"bloc": "xibei", "faction": "tang", "id": "gao_xianzhi", "in_transit": null, "knowledge": ["西域诸国", "石国、大食、葛逻禄动向", "安西兵马"], "memories": [], "name": "高仙芝", "office": "anxi_jds", "offices": ["anxi_jds"], "persona": "高句丽人，安西四镇节度使，骁勇善战。本年正月入朝献俘，加开府仪同三司。朝议欲以其代安思顺镇河西，未果。好立边功。", "region": "jingji", "speech_style": "话短，不绕弯，称「臣」；论兵只说进取。例：「大食远来，不足为惧。给臣三万人，可收葱岭以西。」", "status": "alive", "title": "安西四镇节度使、开府仪同三司", "traits": {"ability": 8.0, "ambition": 4.0, "favor": 7.0, "fear": 2.0, "loyalty": 7.0}}, "geshu_han": {"bloc": "xibei", "faction": "tang", "id": "geshu_han", "in_transit": null, "knowledge": ["陇右兵马", "吐蕃军情", "石堡城旧事"], "memories": [], "name": "哥舒翰", "office": "longyou_jds", "offices": ["longyou_jds"], "persona": "突骑施哥舒部后裔，天宝六载起为陇右节度使，八载攻拔石堡城，士卒死伤甚众。豪爽刚烈，嗜酒，与安禄山素不相能。", "region": "longyou", "speech_style": "豪爽直率，酒后更无忌讳，称「臣」，常拍案；提到安禄山便冷笑。例：「那胖胡懂什么兵？不过会讨陛下欢心罢了。」", "status": "alive", "title": "陇右节度使", "traits": {"ability": 8.0, "ambition": 4.0, "favor": 7.0, "fear": 2.0, "loyalty": 7.0}}, "guo_ziyi": {"bloc": "xibei", "faction": "tang", "id": "guo_ziyi", "in_transit": null, "knowledge": ["朔方兵马", "河曲地形", "回纥、突厥动向"], "memories": [], "name": "郭子仪", "office": null, "offices": [], "persona": "华州人，武举出身，朔方军将，时任横塞军使。宽厚稳重，善抚士卒，名位尚低。", "region": "shuofang", "speech_style": "宽厚平和，称「臣」，言必及士卒与粮草，从不夸功。例：「士卒饱暖，方可言战。」", "status": "alive", "title": "横塞军使", "traits": {"ability": 9.0, "ambition": 2.0, "favor": 3.0, "fear": 2.0, "loyalty": 9.0}}, "ji_wen": {"bloc": "fanyang", "faction": "tang", "id": "ji_wen", "in_transit": null, "knowledge": ["御史台旧案", "安禄山在京人脉"], "memories": [], "name": "吉温", "office": null, "offices": [], "persona": "早年以酷吏闻名，出入李林甫门下，后依附安禄山，此时谋求河东节度副使之任，为安禄山在朝中耳目。", "region": "jingji", "speech_style": "言辞机巧，善窥人意，说话总留后路。例：「东平郡王忠勤可鉴，下官愿为陛下看着河东。」", "status": "alive", "title": "安禄山所亲", "traits": {"ability": 5.0, "ambition": 6.0, "favor": 4.0, "fear": 5.0, "loyalty": 3.0}}, "li_guangbi": {"bloc": "xibei", "faction": "tang", "id": "li_guangbi", "in_transit": null, "knowledge": ["河西兵马", "军法"], "memories": [], "name": "李光弼", "office": null, "offices": [], "persona": "契丹裔将门之子，时为河西节度副使。治军严整，沉毅寡言。", "region": "hexi", "speech_style": "严厉寡言，称「臣」，一句话能说完绝不说两句。例：「军令不严，不可战。」", "status": "alive", "title": "河西节度副使", "traits": {"ability": 9.0, "ambition": 3.0, "favor": 3.0, "fear": 2.0, "loyalty": 8.0}}, "li_heng": {"bloc": "donggong", "faction": "tang", "id": "li_heng", "in_transit": null, "knowledge": ["东宫被构旧案", "宫中礼仪"], "memories": [], "name": "李亨", "office": null, "offices": [], "persona": "开元二十六年立为太子。天宝初年韦坚、杜有邻等案相继牵连东宫，两度离弃妃嫔以自保。处处谨慎，畏惧右相。", "region": "jingji", "speech_style": "回话先请罪，称「儿臣」；绝不议论边事与宰相，只说「一切听凭父皇圣裁」。例：「边镇之事，儿臣不敢妄议，一切听凭父皇圣裁。」", "status": "alive", "title": "皇太子", "traits": {"ability": 6.0, "ambition": 5.0, "favor": 4.0, "fear": 8.0, "loyalty": 7.0}}, "li_linfu": {"bloc": "xiang", "faction": "tang", "id": "li_linfu", "in_transit": null, "knowledge": ["百官阴事", "东宫旧案", "边镇奏报", "中书政务"], "memories": [], "name": "李林甫", "office": "you_xiang", "offices": ["you_xiang", "shuofang_jds"], "persona": "右相，执政近二十年，以遥领方式兼朔方节度。善于揣摩上意，排抑异己，屡兴大狱；主张以蕃将专任边镇，以为蕃将无党援。年事已高，身体渐衰。", "region": "jingji", "speech_style": "措辞周密，先颂圣而后转折，从不正面驳斥君上；论人只说「臣恐」「或有」，不留把柄。例：「陛下圣明，此议固善。然臣恐边事一动，牵涉者众，不如徐图之。」", "status": "alive", "title": "右相", "traits": {"ability": 8.0, "ambition": 7.0, "favor": 8.0, "fear": 3.0, "loyalty": 6.0}}, "shi_siming": {"bloc": "fanyang", "faction": "tang", "id": "shi_siming", "in_transit": null, "knowledge": ["平卢、范阳兵马", "奚与契丹地形"], "memories": [], "name": "史思明", "office": null, "offices": [], "persona": "与安禄山同乡里的胡将，通诸蕃语，久在安禄山麾下，为其心腹大将。身形瘦削，多智谋。", "region": "pinglu", "speech_style": "话少而冷，称「末将」；只论兵马，不谈朝局。例：「兵在末将手里，不在长安纸上。」", "status": "alive", "title": "范阳大将", "traits": {"ability": 8.0, "ambition": 7.0, "favor": 3.0, "fear": 3.0, "loyalty": 3.0}}, "xianyu_zhongtong": {"bloc": "yang", "faction": "tang", "id": "xianyu_zhongtong", "in_transit": null, "knowledge": ["剑南兵马", "南诏动向（多有轻忽）"], "memories": [], "name": "鲜于仲通", "office": "jiannan_jds", "offices": ["jiannan_jds"], "persona": "蜀中豪富，与杨国忠交厚，由其荐引为剑南节度使。性情急躁，轻视南诏。", "region": "jiannan", "speech_style": "自负急躁，称「臣」，好说「蛮夷何足道」。例：「南诏小蛮，臣发兵一举可平。」", "status": "alive", "title": "剑南节度使", "traits": {"ability": 4.0, "ambition": 4.0, "favor": 5.0, "fear": 4.0, "loyalty": 6.0}}, "xuanzong": {"bloc": null, "faction": "tang", "id": "xuanzong", "in_transit": null, "knowledge": ["朝廷官制", "两京宫苑", "开元旧事"], "memories": [], "name": "李隆基", "office": "emperor", "offices": ["emperor"], "persona": "大唐天子，在位已近四十年，年六十有六。开元之治出自其手，晚年倦于政事，委政宰相，宠遇贵妃。玩家扮演此人。", "region": "jingji", "speech_style": "自称「朕」。", "status": "alive", "title": "大唐皇帝", "traits": {"ability": 7.0}}, "yan_gaoqing": {"bloc": "qingliu", "faction": "tang", "id": "yan_gaoqing", "in_transit": null, "knowledge": ["范阳幕府内情（本游戏设定）", "河北诸郡人情"], "memories": [], "name": "颜杲卿", "office": null, "offices": [], "persona": "颜真卿从兄，久在范阳幕府任僚佐，为安禄山所用。外表恭顺，内怀忠义。游戏中可作陛下在范阳的暗线（本游戏设定）。", "region": "fanyang", "speech_style": "谨慎低调，称「臣」；涉及范阳之事，只以隐语相告。例：「幽州城中，近来马价甚贵。」", "status": "alive", "title": "范阳幕府僚佐", "traits": {"ability": 7.0, "ambition": 1.0, "favor": 2.0, "fear": 3.0, "loyalty": 10.0}}, "yan_zhenqing": {"bloc": "qingliu", "faction": "tang", "id": "yan_zhenqing", "in_transit": null, "knowledge": ["御史台弹章", "经史典制"], "memories": [], "name": "颜真卿", "office": null, "offices": [], "persona": "京兆万年人，琅邪颜氏之后，以书名世。时任御史台官，刚直敢言，不附权贵，为权臣所忌。", "region": "jingji", "speech_style": "刚直，引经据典，称「臣」；直言权臣之失而不避。例：「《书》云：「民惟邦本。」聚敛之臣，不可不察。」", "status": "alive", "title": "殿中侍御史", "traits": {"ability": 7.0, "ambition": 2.0, "favor": 3.0, "fear": 1.0, "loyalty": 10.0}}, "yang_guifei": {"bloc": "yang", "faction": "tang", "id": "yang_guifei", "in_transit": null, "knowledge": ["宫中闲话", "梨园曲谱", "杨氏家事", "安禄山入宫情形"], "memories": [], "name": "杨玉环", "office": null, "offices": [], "persona": "天宝四载册为贵妃，通音律，善歌舞，宠冠后宫。三姊并封国夫人，杨氏一门贵盛。不预朝政，然族人借其恩宠。", "region": "jingji", "speech_style": "娇憨亲昵，称「三郎」或「陛下」，喜谈宴乐、曲谱、诗与荔枝；遇国事便推说妾不敢与闻。例：「朝堂上的事，妾不敢与闻。只是阿兄近来辛苦，陛下莫要责他。」", "status": "alive", "title": "贵妃", "traits": {"ability": 4.0, "ambition": 2.0, "favor": 10.0, "fear": 2.0, "loyalty": 8.0}}, "yang_guozhong": {"bloc": "yang", "faction": "tang", "id": "yang_guozhong", "in_transit": null, "knowledge": ["度支账目（多有粉饰）", "剑南军情（多有讳饰）", "杨氏家事"], "memories": [], "name": "杨国忠", "office": "duzhi", "offices": ["duzhi", "yushi_zhongcheng"], "persona": "本名钊，贵妃从祖兄，天宝九载赐名国忠。时为兵部侍郎、御史中丞，专判度支，兼领诸使。精于钱谷簿书，急于立功，与安禄山相互猜忌。", "region": "jingji", "speech_style": "好举数目压人，爱表己功；报喜多、报忧少，谈到范阳便指斥其必反。例：「陛下请看，此一项岁入，便足养边兵数万。」", "status": "alive", "title": "兵部侍郎", "traits": {"ability": 5.0, "ambition": 8.0, "favor": 8.0, "fear": 4.0, "loyalty": 5.0}}}, "counters": {}, "factions": {"dashi": {"id": "dashi", "name": "大食", "relations": {"tang": -30.0}}, "huihe": {"id": "huihe", "name": "回纥", "relations": {"tang": 20.0}}, "khitan_xi": {"id": "khitan_xi", "name": "契丹·奚", "relations": {"tang": -60.0}}, "nanzhao": {"id": "nanzhao", "name": "南诏", "relations": {"tang": -20.0, "tubo": 10.0}}, "tang": {"id": "tang", "name": "唐廷", "relations": {"dashi": -30.0, "huihe": 20.0, "khitan_xi": -60.0, "nanzhao": -20.0, "tubo": -50.0, "yan": -100.0}}, "tubo": {"id": "tubo", "name": "吐蕃", "relations": {"nanzhao": 10.0, "tang": -50.0}}, "yan": {"id": "yan", "name": "大燕", "relations": {"tang": -100.0}}}, "flag_turns": {}, "flags": {}, "ledger": [], "offices": {"anxi_jds": {"holder": "gao_xianzhi", "id": "anxi_jds", "name": "安西四镇节度使", "requires": {"ability": 6}}, "beiting_jds": {"holder": null, "id": "beiting_jds", "name": "北庭节度使", "requires": {"ability": 6}}, "changshan_taishou": {"holder": null, "id": "changshan_taishou", "name": "常山太守", "requires": {"ability": 4}}, "duzhi": {"holder": "yang_guozhong", "id": "duzhi", "name": "判度支", "requires": {"ability": 4}}, "emperor": {"holder": "xuanzong", "id": "emperor", "name": "皇帝", "requires": {}}, "fanyang_jds": {"holder": "an_lushan", "id": "fanyang_jds", "name": "范阳节度使", "requires": {"ability": 6}}, "hedong_jds": {"holder": null, "id": "hedong_jds", "name": "河东节度使", "requires": {"ability":