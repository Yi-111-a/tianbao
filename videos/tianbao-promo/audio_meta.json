        }
      ]
    },
    {
      "frame": 2,
      "path": "audio/vo-02.wav",
      "duration_s": 6.456,
      "words": [
        {
          "text": "什么都不做",
          "start": 0.103,
          "end": 0.984,
          "id": "w4"
        },
        {
          "text": "等待历史重演",
          "start": 1.142,
          "end": 2.405,
          "id": "w5"
        },
        {
          "text": "还是励精图治",
          "start": 3.013,
          "end": 4.355,
          "id": "w6"
        },
        {
          "text": "阻止安史之乱",
          "start": 4.539,
          "end": 5.842,
          "id": "w7"
        }
      ]
    },
    {
      "frame": 3,
      "path": "audio/vo-03.wav",
      "duration_s": 3.816,
      "words": [
        {
          "text": "这是",
          "start": 0.103,
          "end": 0.432,
          "id": "w8"
        },
        {
          "text": "天宝",
          "start": 0.445,
          "end": 0.945,
          "id": "w9"
        },
        {
          "text": "这一次",
          "start": 1.553,
          "end": 2.171,
          "id": "w10"
        },
        {
          "text": "你是唐玄宗",
          "start": 2.303,
          "end": 3.21,
          "id": "w11"
        }
      ]
    },
    {
      "frame": 4,
      "path": "audio/vo-04.wav",
      "duration_s": 7.896,
      "words": [
        {
          "text": "奏疏从千里外送来",
          "start": 0.103,
          "end": 1.708,
          "id": "w12"
        },
        {
          "text": "会迟到",
          "start": 1.813,
          "end": 2.497,
          "id": "w13"
        },
        {
          "text": "召安禄山入殿",
          "start": 3.105,
          "end": 4.224,
          "id": "w14"
        },
        {
          "text": "当面问他",
          "start": 4.461,
          "end": 5.211,
          "id": "w15"
        },
        {
          "text": "范阳的兵",
          "start": 5.303,
          "end": 6.079,
          "id": "w16"
        },
        {
          "text": "到底听谁的",
          "start": 6.25,
          "end": 7.303,
          "id": "w17"
        }
      ]
    },
    {
      "frame": 5,
      "path": "audio/vo-05.wav",
      "duration_s": 4.056,
      "words": [
        {
          "text": "廷议上",
